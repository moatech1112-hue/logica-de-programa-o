programa {
  funcao inicio() {
    inteiro numA, numB
    
     escreva("digite o primeiro numero: ")
     leia(numA)
     escreva("digite o segundo numero: ")
     leia(numB)

     escreva("a soma dos numeros é: ", numA+numB, "\n")
     escreva("a subtração dos numeros é: ", numA-numB, "\n")
     escreva("a multiplicação é: ", numA*numB, "\n")
     escreva("a divisão é: ", numA/numB)

  }
}
